<mxfile host="Electron" type="device">
  <diagram name="Cockpit Tasks workflow" id="page-1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="How Cockpit Tasks work" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontColor=#42365e;fontFamily=Arial;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="A request becomes tracked work. Owner feedback stays linked to the same task." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#42365e;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;OWNER&lt;/b&gt;&lt;br&gt;Defines the request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;AGENT&lt;/b&gt;&lt;br&gt;Plans the work" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;QUEUE&lt;/b&gt;&lt;br&gt;Waiting to start" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;IN PROGRESS&lt;/b&gt;&lt;br&gt;Edits, commits, executors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="170" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;HISTORY&lt;/b&gt;&lt;br&gt;Task is closed&lt;br&gt;Result is preserved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="450" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;BACKLOG&lt;/b&gt;&lt;br&gt;Reason recorded&lt;br&gt;Resume when ready" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="450" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;OWNER REVIEW&lt;/b&gt;&lt;br&gt;Review card¹&lt;br&gt;Choose an outcome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;ACCEPTED&lt;/b&gt;&lt;br&gt;Agent receives the reply&lt;br&gt;Task remains in history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9280da;strokeWidth=2;fontColor=#42365e;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
